# ── 百炼 API ──
BAILIAN_API_KEY=sk-2ddb885e947b441fbcedaf6923c6eed5
BAILIAN_WORKSPACE_ID=llm-j6aqu8cj9c6nfjjs
BAILIAN_REGION=cn-beijing
BAILIAN_LLM_MODEL=qwen-plus
BAILIAN_ASR_MODEL=qwen3-asr-flash-realtime
BAILIAN_TTS_MODEL=qwen3-tts-flash-realtime
BAILIAN_TTS_VOICE=Cherry
BAILIAN_VLM_MODEL=qwen-vl-plus

# ── 部署目标 ──
REACHY_TARGET=mac
REACHY_AUDIO_DEVICE=Reachy Mini Audio
# 麦克风增益 (1.0=原始音量, 过高会导致削波失真影响识别)
REACHY_MIC_GAIN=1.0
# 按设备名自动锁定 Reachy Mini，避免 macOS/OpenCV 索引顺序变化后串到 Mac 摄像头
REACHY_CAMERA_DEVICE=auto

# ── 唤醒词（云端 ASR 文本匹配，不需要本地模型）──
BAILIAN_ENABLE_WAKE_WORD=true
BAILIAN_WAKE_WORDS=皮皮虾

# ── 对话 ──
REACHY_LANGUAGE=zh
BAILIAN_LLM_TEMPERATURE=0.4
BAILIAN_LLM_MAX_TOKENS=300
# 服务端 VAD：500ms 静音判定结束（xiaozhi 风格），0.35 灵敏度适配轻声
BAILIAN_ASR_VAD_SILENCE_MS=500
BAILIAN_ASR_VAD_THRESHOLD=0.35

# ── 萤石车后方摄像头 ──
EZVIZ_APP_KEY=65be534a173b4aa8ad7842753d377128
EZVIZ_APP_SECRET=aaef1cf2e632b134595520f50d92c480
EZVIZ_DEVICE_SERIAL=BG9251347
EZVIZ_CHANNEL_NO=1
