# 阿里云百炼
BAILIAN_API_KEY=
BAILIAN_WORKSPACE_ID=
BAILIAN_LLM_MODEL=qwen3.7-plus
REACHY_SEARCH_POLICY=auto
REACHY_VISION_POLICY=semantic
REACHY_VISUAL_CONTEXT_TTL_S=15
REACHY_VISION_MAX_CALLS_PER_TURN=1

# 单手 21 点姿态交互（模型制品需先按 scripts/export_hand_pose_models.py 构建）
REACHY_GESTURE_BACKEND=auto
REACHY_GESTURE_COREML_MODEL=models/hand_pose/hand_pose_resnet18.mlpackage
REACHY_GESTURE_TORCHSCRIPT_MODEL=models/hand_pose/hand_pose_resnet18.ts
REACHY_GESTURE_TENSORRT_ENGINE=models/hand_pose/hand_pose_resnet18_fp16.engine
REACHY_GESTURE_TORCH2TRT_MODEL=models/hand_pose/hand_pose_resnet18_torch2trt.pth
REACHY_GESTURE_INFERENCE_FPS=15
REACHY_GESTURE_KEYPOINT_CONFIDENCE=0.15
REACHY_GESTURE_CONFIRMATION_MS=300
REACHY_GESTURE_LOST_TIMEOUT_MS=800
REACHY_GESTURE_TRACKING_DEADZONE=0.06
REACHY_GESTURE_TRACKING_ALPHA=0.35
REACHY_GESTURE_TRACKING_MAX_STEP_DEG=2
REACHY_GESTURE_HEAD_YAW_MAX_DEG=20
REACHY_GESTURE_HEAD_PITCH_MAX_DEG=20
REACHY_GESTURE_BODY_YAW_MAX_DEG=30

# 高德 Web 服务 API（开启数字签名时两项都要填写）
AMAP_WEB_KEY=
AMAP_WEB_PRIVATE_KEY=

# 会话与实时定位（口头地点只作会话备注，不覆盖实时点位）
REACHY_MAX_HISTORY_TURNS=20
REACHY_SESSION_RESET_IDLE_S=1800
REACHY_LOCATION_WIFI_ENABLED=true
REACHY_LOCATION_WIFI_SCAN_INTERVAL_S=10

# 嘈杂环境音频前端 V2
REACHY_AUDIO_FRONTEND_V2=true
REACHY_VAD_ON_THRESHOLD=0.60
REACHY_VAD_OFF_THRESHOLD=0.35
REACHY_ENDPOINT_SILENCE_MS=700
REACHY_MAX_UTTERANCE_S=15
REACHY_DOA_TOLERANCE_DEG=35
REACHY_FOLLOWUP_WINDOW_S=8

# 可回滚的新检索/路由
JOURNAL_INDEX_V3=true
SOURCE_ROUTER_V2=true
SESSION_STATE_V2=true
